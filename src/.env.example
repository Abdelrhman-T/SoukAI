# ==================== App Config ======================
APP_NAME= "SoukAI"
APP_VERSION= "V1.0"

PRIMARY_LANG = "ar"
DEFAULT_LANG = "en"

# =================== LLM Backend Config ===============
BACKEND_LITERAL = ["GROQ", "OPENROUTER"]
GENERATION_BACKEND="GROQ"
JUDGE_BACKEND="GROQ"
MODEL_JUDGE = "openai/gpt-oss-120b"

# =================== OpenRouter Config ================
OPENROUTER_API_KEY = ""
OPENROUTER_URL = "https://openrouter.ai/api/v1/chat/completions"

OPENROUTER_MODEL_LITERAL = ["liquid/lfm-2.5-1.2b-instruct:free","nex-agi/nex-n2-pro:free", "google/gemma-4-26b-a4b-it:free", "moonshotai/kimi-k2.6:free"]
OPENROUTER_MODEL = "moonshotai/kimi-k2.6:free"

# ==================== Groq Config =====================
GROQ_API_KEY= ""
GROQ_MODEL="openai/gpt-oss-20b"

# ================= Generation Defaults ================
DEFAULT_INPUT_MAX_CHARACTERS=1024
DEFAULT_MAX_OUTPUT_TOKENS=512
DEFAULT_TEMPERATURE=0.1

# ================= User-Facing Messages ===============
SAFETY_BLOCK_MESSAGE = "لا يمكن معالجة الطلب لأنه خالف قواعد الأمان."
INJECTION_BLOCK_MESSAGE = "لا يمكن معالجة الطلب لأنه يحتوي على محاولة لتغيير تعليمات النظام."
EMPTY_INPUT_MESSAGE = "حقل `text` لا يمكن أن يكون فارغًا."
LONG_INPUT_MESSAGE = "حقل `text` أطول من الحد المسموح به."

MISSING_ORDER_ID_MESSAGE = "من فضلك أرسل رقم الطلب أو رقم الحجز حتى أقدر أساعدك."
ORDER_NOT_FOUND_MESSAGE = "لم أتمكن من العثور على الطلب. تأكد من رقم الطلب وأعد إرساله."

# ================= Model Pricing =====================
GROQ_INPUT_PER_1K= 0.0
GROQ_OUTPUT_PER_1K= 0.0

OPENROUTER_INPUT_PER_1K= 0.0
OPENROUTER_OUTPUT_PER_1K= 0.0

# ================ Meta / Facebook Config =============
META_GRAPH_VERSION="v25.0"

FACEBOOK_PAGE_ACCESS_TOKEN=""
FACEBOOK_PAGE_ID=""
META_VERIFY_TOKEN=""